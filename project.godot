config_version=5

[application]

config/name="Paws & Quests"
config/version="1.0.8"
run/main_scene="res://scenes/world/world.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

