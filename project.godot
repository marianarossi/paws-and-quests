[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.pt_BR.translation")

[layer_names]

2d_physics/layer_1="mundo"
2d_physics/layer_2="jogador"
2d_physics/layer_3="perigos"
2d_physics/layer_4="inimigos"
2d_physics/layer_5="projeteis"
2d_physics/layer_6="interagiveis"

[physics]

common/physics_ticks_per_second=120
common/physics_jitter_fix=0.0
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.051, 0.043, 0.102, 1)

[shader_globals]

hero_pos={
"type": "vec2",
"value": Vector2(-10000, -10000)
}
